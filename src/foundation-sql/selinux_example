cd /usr/share/mariadb/policy/selinux/
tee ./mysqld_nfs.te <<EOF
module mysqld_nfs 1.0;

require {
type nfs_t;
type mysqld_t;
class dir { write search read remove_name open getattr add_name };
class file { write getattr read lock create unlink open };
}

allow mysqld_t nfs_t:dir { write search read remove_name open getattr add_name };

allow mysqld_t nfs_t:file { write getattr read lock create unlink open }
EOF
sudo checkmodule -M -m mysqld_nfs.te -o mysqld_nfs.mod
sudo semodule_package -m mysqld_nfs.mod -o mysqld_nfs.pp 
sudo semodule -i mysqld_nfs.pp
